// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Character {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   // "zombie" o "robot"
  health    Int
  attack    Int
  defense   Int
  speed     Int
  createdAt DateTime @default(now())

  battlesAsChar1 Battle[] @relation("Character1")
  battlesAsChar2 Battle[] @relation("Character2")
  battlesWon     Battle[] @relation("Winner")
}

model Battle {
  id           Int       @id @default(autoincrement())
  character1   Character @relation("Character1", fields: [character1Id], references: [id])
  character1Id Int
  character2   Character @relation("Character2", fields: [character2Id], references: [id])
  character2Id Int
  winner       Character @relation("Winner", fields: [winnerId], references: [id])
  winnerId     Int
  turns        Int
  createdAt    DateTime  @default(now())
}